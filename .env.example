# GEMINI_API_KEY: Required for Gemini AI post and thumbnail generation (server-side only).
GEMINI_API_KEY=

# DATABASE_URL: PostgreSQL connection string for persistent production storage (e.g. Render Postgres).
# If omitted in local development, the app automatically falls back to SQLite (./data/autoblog.db).
DATABASE_URL=

# ADMIN_PASSWORD: Password required to access the /admin dashboard.
# If omitted on first launch, /admin displays a one-time setup form to claim an admin password.
ADMIN_PASSWORD=

# GITHUB_TOKEN: Optional personal access token for higher GitHub API rate limits when monitoring repos.
GITHUB_TOKEN=

# CHECK_INTERVAL_MINUTES: Monitoring schedule interval in minutes (default: 10).
CHECK_INTERVAL_MINUTES=10

# SITE_URL: Public canonical base URL of your deployed blog (used for RSS, sitemap, and Open Graph tags).
SITE_URL=

# APP_URL: Runtime URL injected by hosting platform (used as fallback if SITE_URL is unset).
APP_URL=
