# GEMINI_API_KEY: Required for Gemini AI post and thumbnail generation (server-side only).
GEMINI_API_KEY=

# DATABASE_URL: PostgreSQL connection string for persistent production storage (e.g. Render Postgres).
# If omitted in local development, the app automatically falls back to SQLite (./data/autoblog.db).
DATABASE_URL=

# ADMIN_PASSWORD: Password required to access the hidden admin dashboard.
# If omitted on first launch, the admin route displays a one-time setup form.
ADMIN_PASSWORD=

# ADMIN_PATH: Hidden URL path for the admin dashboard (default: /admin-mrs).
ADMIN_PATH=/admin-mrs

# GITHUB_TOKEN: Optional personal access token for higher GitHub API rate limits when monitoring repos.
GITHUB_TOKEN=

# CHECK_INTERVAL_MINUTES: Monitoring schedule interval in minutes (default: 1 for near real-time publishing).
CHECK_INTERVAL_MINUTES=1

# CHECK_INTERVAL_SECONDS: Optional sub-minute check interval in seconds (minimum 15; overrides CHECK_INTERVAL_MINUTES when set).
CHECK_INTERVAL_SECONDS=

# SITE_URL: Public canonical base URL of your deployed blog (used for RSS, sitemap, and Open Graph tags).
SITE_URL=

# APP_URL: Runtime URL injected by hosting platform (used as fallback if SITE_URL is unset).
APP_URL=
